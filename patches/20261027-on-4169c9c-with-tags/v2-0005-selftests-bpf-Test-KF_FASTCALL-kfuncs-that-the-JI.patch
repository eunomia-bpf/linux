diff --git a/tools/testing/selftests/bpf/prog_tests/kfunc_inline.c b/tools/testing/selftests/bpf/prog_tests/kfunc_inline.c
new file mode 100644
index 000000000000..1008df681ae9
--- /dev/null
+++ b/tools/testing/selftests/bpf/prog_tests/kfunc_inline.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <test_progs.h>
+#include <stdlib.h>
+#include "kfunc_inline.skel.h"
+#include "kfunc_inline_jit.skel.h"
+
+static __u64 rol64(__u64 x, unsigned int n)
+{
+	n &= 63;
+	return n ? x << n | x >> (64 - n) : x;
+}
+
+static __u64 mix(__u64 a)
+{
+	return (a >> 7) ^ ((a << 3) + (a >> 11)) ^ (a * 5);
+}
+
+static __u64 rand64(void)
+{
+	return (__u64)rand() << 62 ^ (__u64)rand() << 31 ^ rand();
+}
+
+/* Compare kfuncs that the JIT may inline with their C definitions */
+static void check_random(void)
+{
+	LIBBPF_OPTS(bpf_test_run_opts, opts);
+	struct kfunc_inline *skel;
+	int i, fd, err;
+
+	skel = kfunc_inline__open_and_load();
+	if (!ASSERT_OK_PTR(skel, "kfunc_inline__open_and_load"))
+		return;
+	fd = bpf_program__fd(skel->progs.kfunc_inline);
+	srand(42);
+	for (i = 0; i < 1000; i++) {
+		skel->bss->in_x = rand64();
+		skel->bss->in_y = i % 7 ? rand64() : 0;
+		skel->bss->in_n = rand() % 70;
+		skel->bss->in_c = i % 3 ? rand64() : 0;
+		err = bpf_prog_test_run_opts(fd, &opts);
+		if (!ASSERT_OK(err, "bpf_prog_test_run_opts"))
+			break;
+		if (!ASSERT_EQ(skel->bss->out_rol, rol64(skel->bss->in_x, skel->bss->in_n), "rol64") ||
+		    !ASSERT_EQ(skel->bss->out_sel,
+			       skel->bss->in_c ? skel->bss->in_x : skel->bss->in_y, "select64") ||
+		    !ASSERT_EQ(skel->bss->out_lt, skel->bss->in_x < skel->bss->in_y, "lt") ||
+		    !ASSERT_EQ(skel->bss->out_mix, mix(skel->bss->in_x), "mix") ||
+		    !ASSERT_EQ(skel->bss->out_div,
+			       skel->bss->in_y ? skel->bss->in_x / skel->bss->in_y : 0, "div"))
+			break;
+	}
+	kfunc_inline__destroy(skel);
+}
+
+/* Not in verifier.c: its tests run without CAP_SYS_ADMIN, which libbpf needs
+ * to find the bpf_testmod kfuncs.
+ */
+void test_kfunc_inline(void)
+{
+	if (test__start_subtest("random"))
+		check_random();
+	RUN_TESTS(kfunc_inline_jit);
+}
diff --git a/tools/testing/selftests/bpf/progs/kfunc_inline.c b/tools/testing/selftests/bpf/progs/kfunc_inline.c
new file mode 100644
index 000000000000..3abd143e3053
--- /dev/null
+++ b/tools/testing/selftests/bpf/progs/kfunc_inline.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#define BPF_NO_KFUNC_PROTOTYPES
+#include <vmlinux.h>
+#include <bpf/bpf_helpers.h>
+#include "bpf_misc.h"
+#include "../test_kmods/bpf_testmod_kfunc.h"
+
+extern __u64 bpf_rol64(__u64 x, __u32 n) __ksym;
+extern __u64 bpf_select64(__u64 cond, __u64 a, __u64 b) __ksym;
+
+__u64 in_x, in_y, in_n, in_c;
+__u64 out_rol, out_sel, out_lt, out_mix, out_div;
+
+SEC("syscall")
+int kfunc_inline(void *ctx)
+{
+	out_rol = bpf_rol64(in_x, in_n);
+	out_sel = bpf_select64(in_c, in_x, in_y);
+	out_lt = bpf_kfunc_call_test_fastcall_lt(in_x, in_y);
+	out_mix = bpf_kfunc_call_test_fastcall_mix(in_x);
+	out_div = bpf_kfunc_call_test_fastcall_div(in_x, in_y);
+	return 0;
+}
+
+char _license[] SEC("license") = "GPL";
diff --git a/tools/testing/selftests/bpf/progs/kfunc_inline_jit.c b/tools/testing/selftests/bpf/progs/kfunc_inline_jit.c
new file mode 100644
index 000000000000..d7834079771c
--- /dev/null
+++ b/tools/testing/selftests/bpf/progs/kfunc_inline_jit.c
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#define BPF_NO_KFUNC_PROTOTYPES
+#include <vmlinux.h>
+#include <bpf/bpf_helpers.h>
+#include "bpf_misc.h"
+#include "../test_kmods/bpf_testmod_kfunc.h"
+
+extern __u64 bpf_rol64(__u64 x, __u32 n) __ksym;
+extern __u64 bpf_select64(__u64 cond, __u64 a, __u64 b) __ksym;
+
+/* The JIT copies bpf_rol64() and the verifier removes the spill/fill of r4.
+ * On x86-64 the copy uses rcx, which holds r4, so the JIT pushes and pops it.
+ */
+SEC("tc")
+__arch_x86_64
+__xlated("0: r1 = 0x123456789abcdef")
+__xlated("2: r2 = 8")
+__xlated("3: r4 = 7")
+__xlated("4: call")
+__xlated("5: r3 = 0x23456789abcdef01")
+__jited("...")
+__jited("	pushq	%rcx")
+__jited("...")
+__jited("	rolq	%cl, %rax")
+__jited("	popq	%rcx")
+__arch_arm64
+__jited("...")
+__jited("	ror	x0, x0, x{{[0-9]+}}")
+__jited("	mov	x8, x0")
+__success __retval(1)
+__naked void kfunc_inline_rol64_keeps_live_reg(void)
+{
+	asm volatile (
+	"r1 = 0x0123456789abcdef ll;"
+	"r2 = 8;"
+	"r4 = 7;"
+	"*(u64 *)(r10 - 8) = r4;"
+	"call %[bpf_rol64];"
+	"r4 = *(u64 *)(r10 - 8);"
+	"r3 = 0x23456789abcdef01 ll;"
+	"if r0 != r3 goto 1f;"
+	"if r4 != 7 goto 1f;"
+	"r0 = 1;"
+	"exit;"
+"1:"
+	"r0 = 0;"
+	"exit;"
+	:
+	: __imm(bpf_rol64)
+	: __clobber_all);
+}
+
+/* r4 is not live after the call, so the JIT does not push/pop rcx */
+SEC("tc")
+__arch_x86_64
+__jited("...")
+__jited("	movl	$0x8, %esi")
+__jited("	{{movl	%esi, %ecx|movq	%rdi, %rax}}")
+__jited("	{{movl	%esi, %ecx|movq	%rdi, %rax}}")
+__jited("	rolq	%cl, %rax")
+__arch_arm64
+__jited("...")
+__jited("	ror	x0, x0, x{{[0-9]+}}")
+__jited("	mov	x8, x0")
+__success __retval(0x23)
+__naked void kfunc_inline_rol64_dead_reg(void)
+{
+	asm volatile (
+	"r1 = 0x0123456789abcdef ll;"
+	"r2 = 8;"
+	"call %[bpf_rol64];"
+	"r0 >>= 56;"
+	"exit;"
+	:
+	: __imm(bpf_rol64)
+	: __clobber_all);
+}
+
+/* bpf_select64() uses only its arguments and the result register: r4 and r5
+ * survive it without being saved once their spill/fill is removed.
+ */
+SEC("tc")
+__arch_x86_64
+__xlated("0: r1 = 0")
+__xlated("1: r2 = 2")
+__xlated("2: r3 = 3")
+__xlated("3: r4 = 4")
+__xlated("4: r5 = 5")
+__xlated("5: call")
+__xlated("6: r0 += r4")
+__jited("...")
+__jited("	{{cmov.*}}")
+__arch_arm64
+__jited("...")
+__jited("	{{csel.*}}")
+__jited("	mov	x8, x0")
+__jited("	add	x8, x8, x3")
+__success __retval(12)
+__naked void kfunc_inline_select64(void)
+{
+	asm volatile (
+	"r1 = 0;"
+	"r2 = 2;"
+	"r3 = 3;"
+	"r4 = 4;"
+	"r5 = 5;"
+	"*(u64 *)(r10 - 8) = r4;"
+	"*(u64 *)(r10 - 16) = r5;"
+	"call %[bpf_select64];"
+	"r5 = *(u64 *)(r10 - 16);"
+	"r4 = *(u64 *)(r10 - 8);"
+	"r0 += r4;"
+	"r0 += r5;"
+	"exit;"
+	:
+	: __imm(bpf_select64)
+	: __clobber_all);
+}
+
+/* A comparison compiles to setcc on x86-64 and cset on arm64 */
+SEC("tc")
+__arch_x86_64
+__xlated("0: r1 = 3")
+__xlated("1: r2 = 5")
+__xlated("2: r5 = 9")
+__xlated("3: call")
+__xlated("4: r0 += r5")
+__jited("...")
+__jited("	{{setb	%al|setae	%al|seta	%al|setbe	%al|setl	%al|setg	%al}}")
+__arch_arm64
+__jited("...")
+__jited("	cmp	x0, x1")
+__jited("	{{cset.*}}")
+__jited("	mov	x8, x0")
+__jited("	add	x8, x8, x4")
+__success __retval(10)
+__naked void kfunc_inline_byte_ops(void)
+{
+	asm volatile (
+	"r1 = 3;"
+	"r2 = 5;"
+	"r5 = 9;"
+	"*(u64 *)(r10 - 8) = r5;"
+	"call %[bpf_kfunc_call_test_fastcall_lt];"
+	"r5 = *(u64 *)(r10 - 8);"
+	"r0 += r5;"
+	"exit;"
+	:
+	: __imm(bpf_kfunc_call_test_fastcall_lt)
+	: __clobber_all);
+}
+
+/* The copied code uses some of r2-r5 as temporaries, the JIT keeps them */
+SEC("tc")
+__arch_x86_64
+__arch_arm64
+__xlated("0: r1 = 1000003")
+__xlated("1: r2 = 2")
+__xlated("2: r3 = 3")
+__xlated("3: r4 = 4")
+__xlated("4: r5 = 5")
+__xlated("5: call")
+__xlated("6: if r2 != 0x2")
+__success __retval(1)
+__naked void kfunc_inline_keeps_live_regs(void)
+{
+	asm volatile (
+	"r1 = 1000003;"
+	"r2 = 2;"
+	"r3 = 3;"
+	"r4 = 4;"
+	"r5 = 5;"
+	"*(u64 *)(r10 - 8) = r2;"
+	"*(u64 *)(r10 - 16) = r3;"
+	"*(u64 *)(r10 - 24) = r4;"
+	"*(u64 *)(r10 - 32) = r5;"
+	"call %[bpf_kfunc_call_test_fastcall_mix];"
+	"r5 = *(u64 *)(r10 - 32);"
+	"r4 = *(u64 *)(r10 - 24);"
+	"r3 = *(u64 *)(r10 - 16);"
+	"r2 = *(u64 *)(r10 - 8);"
+	"if r2 != 2 goto 1f;"
+	"if r3 != 3 goto 1f;"
+	"if r4 != 4 goto 1f;"
+	"if r5 != 5 goto 1f;"
+	"if r0 != 0x3641cb goto 1f;"
+	"r0 = 1;"
+	"exit;"
+"1:"
+	"r0 = 0;"
+	"exit;"
+	:
+	: __imm(bpf_kfunc_call_test_fastcall_mix)
+	: __clobber_all);
+}
+
+/* A kfunc with a branch is not copied: it is called and its spill/fill stays */
+SEC("tc")
+__xlated("0: r1 = 12")
+__xlated("1: r2 = 4")
+__xlated("2: r5 = 9")
+__xlated("3: *(u64 *)(r10 -8) = r5")
+__xlated("4: call")
+__xlated("5: r5 = *(u64 *)(r10 -8)")
+__success __retval(12)
+__naked void kfunc_not_inlined_keeps_spill_fill(void)
+{
+	asm volatile (
+	"r1 = 12;"
+	"r2 = 4;"
+	"r5 = 9;"
+	"*(u64 *)(r10 - 8) = r5;"
+	"call %[bpf_kfunc_call_test_fastcall_div];"
+	"r5 = *(u64 *)(r10 - 8);"
+	"r0 += r5;"
+	"exit;"
+	:
+	: __imm(bpf_kfunc_call_test_fastcall_div)
+	: __clobber_all);
+}
+
+/* BTF FUNC records are not generated for kfuncs referenced from inline
+ * assembly, and libbpf needs them to link the programs: call the kfuncs from C.
+ */
+void kfunc_root(void)
+{
+	bpf_rol64(0, 0);
+	bpf_select64(0, 0, 0);
+	bpf_kfunc_call_test_fastcall_lt(0, 0);
+	bpf_kfunc_call_test_fastcall_mix(0);
+	bpf_kfunc_call_test_fastcall_div(0, 0);
+}
+
+char _license[] SEC("license") = "GPL";
diff --git a/tools/testing/selftests/bpf/test_kmods/bpf_testmod.c b/tools/testing/selftests/bpf/test_kmods/bpf_testmod.c
index 6380f52f4dd2..01229e7a7426 100644
--- a/tools/testing/selftests/bpf/test_kmods/bpf_testmod.c
+++ b/tools/testing/selftests/bpf/test_kmods/bpf_testmod.c
@@ -1307,6 +1307,24 @@ __bpf_kfunc struct prog_test_ret_ii bpf_kfunc_call_test_ret_ii(int a, int b)
 }
 #endif /* __x86_64__ || __aarch64__ */
 
+/* KF_FASTCALL kfuncs for the JIT inlining tests: two that the JIT can copy
+ * and one with a branch that it cannot.
+ */
+__bpf_kfunc u64 bpf_kfunc_call_test_fastcall_lt(u64 a, u64 b)
+{
+	return a < b;
+}
+
+__bpf_kfunc u64 bpf_kfunc_call_test_fastcall_mix(u64 a)
+{
+	return (a >> 7) ^ ((a << 3) + (a >> 11)) ^ (a * 5);
+}
+
+__bpf_kfunc u64 bpf_kfunc_call_test_fastcall_div(u64 a, u64 b)
+{
+	return b ? a / b : 0;
+}
+
 /*
  * Takes no argument on purpose: with no arguments there is nothing for the sret
  * pointer to displace, so this needs no architecture guard even though it
@@ -1923,6 +1941,9 @@ BTF_ID_FLAGS(func, bpf_kfunc_call_test_pair_arg_split8)
 BTF_ID_FLAGS(func, bpf_kfunc_call_test_ptr_arg)
 BTF_ID_FLAGS(func, bpf_kfunc_call_test_pair_arena_arg)
 #endif
+BTF_ID_FLAGS(func, bpf_kfunc_call_test_fastcall_lt, KF_FASTCALL)
+BTF_ID_FLAGS(func, bpf_kfunc_call_test_fastcall_mix, KF_FASTCALL)
+BTF_ID_FLAGS(func, bpf_kfunc_call_test_fastcall_div, KF_FASTCALL)
 BTF_ID_FLAGS(func, bpf_kfunc_call_test_ret_big)
 BTF_ID_FLAGS(func, bpf_kfunc_call_stack_arg)
 BTF_ID_FLAGS(func, bpf_kfunc_call_stack_arg_ptr)
diff --git a/tools/testing/selftests/bpf/test_kmods/bpf_testmod_kfunc.h b/tools/testing/selftests/bpf/test_kmods/bpf_testmod_kfunc.h
index 3b810f1e438f..e4ab4ca7e13f 100644
--- a/tools/testing/selftests/bpf/test_kmods/bpf_testmod_kfunc.h
+++ b/tools/testing/selftests/bpf/test_kmods/bpf_testmod_kfunc.h
@@ -374,4 +374,8 @@ void bpf_testmod_test_hardirq_fn(void);
 void bpf_testmod_test_softirq_fn(void);
 void bpf_kfunc_trigger_ctx_check(void) __ksym;
 
+__u64 bpf_kfunc_call_test_fastcall_lt(__u64 a, __u64 b) __ksym;
+__u64 bpf_kfunc_call_test_fastcall_mix(__u64 a) __ksym;
+__u64 bpf_kfunc_call_test_fastcall_div(__u64 a, __u64 b) __ksym;
+
 #endif /* _BPF_TESTMOD_KFUNC_H */
