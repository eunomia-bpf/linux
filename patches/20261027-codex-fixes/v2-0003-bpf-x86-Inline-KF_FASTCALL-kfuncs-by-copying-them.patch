From 8dc79ab5e84b44feb719501d0da824117f17225a Mon Sep 17 00:00:00 2001
From: Yusheng Zheng <yunwei356@gmail.com>
Date: Tue, 20 Oct 2026 08:02:45 +0000
Subject: [RFC PATCH bpf-next v2 3/6] bpf, x86: Inline KF_FASTCALL kfuncs by
 copying them

A small kfunc often compiles to a few moves and ALU instructions that
take the arguments from rdi, rsi, rdx, rcx and r8, where the JIT keeps
R1-R5, and leave the result in rax, where it keeps R0. Copy that code
into the program instead of calling it. For bpf_rol64():

  r1 = x                 movabs $x,%rdi
  r2 = 8                 mov    $0x8,%esi
  call bpf_rol64         mov    %rdi,%rax
                         mov    %esi,%ecx
                         rol    %cl,%rax

emit_kfunc_inline() skips ENDBR and the ftrace site and decodes the
kfunc up to 'ret' or the jump to the return thunk. It copies the code if
it is at most 64 bytes long and has only moves, ALU operations, cmov,
setcc and zero or sign extensions, without prefixes or rip-relative
operands, and if no instruction has an exception table entry, whose
fixup would not cover the copy. bpf_fastcall lets the code clobber R0
and the arguments, and r10 and r11 are the JIT's temporaries. Of the
other registers, the code may use r9 and those of R0-R5 that hold no
argument; the ones that are live, R0 of a void kfunc and the registers
whose spills and fills the verifier removed, are pushed and popped
around it. Above, if R4 is live, rcx is pushed and popped.

The code is read into a buffer once, then decoded and copied from
there, so that a kprobe armed meanwhile cannot put an int3 into the
program.

Suggested-by: Alexei Starovoitov <ast@kernel.org>
Link: https://lore.kernel.org/bpf/DM6P2S5E5F3M.3RB3ECL75G1PJ@gmail.com/
---
 arch/x86/net/bpf_jit_comp.c | 207 ++++++++++++++++++++++++++++++++++++
 1 file changed, 207 insertions(+)

diff --git a/arch/x86/net/bpf_jit_comp.c b/arch/x86/net/bpf_jit_comp.c
index 6a2fe3d0039d..da7df000bbc1 100644
--- a/arch/x86/net/bpf_jit_comp.c
+++ b/arch/x86/net/bpf_jit_comp.c
@@ -16,8 +16,11 @@
 #include <linux/sort.h>
 #include <linux/execmem.h>
 #include <linux/extable.h>
+#include <linux/ftrace.h>
+#include <linux/kallsyms.h>
 #include <asm/extable.h>
 #include <asm/ftrace.h>
+#include <asm/insn.h>
 #include <asm/set_memory.h>
 #include <asm/nospec-branch.h>
 #include <asm/text-patching.h>
@@ -2574,6 +2577,201 @@ static int emit_unwind_ret_addr(u8 **pprog, u8 *ip)
 	return 0;
 }
 
+/* The longest kfunc to inline, in bytes */
+#define KFUNC_INLINE_MAX	64
+
+static u32 x86_reg_bit(u32 bpf_reg)
+{
+	return BIT(reg2hex[bpf_reg] | is_ereg(bpf_reg) << 3);
+}
+
+/*
+ * Without a REX prefix, byte registers 4-7 are ah, ch, dh and bh, the second
+ * bytes of rax, rcx, rdx and rbx.
+ */
+static u32 kfunc_byte_reg_bit(u8 reg, u8 rex)
+{
+	return !rex && reg >= 4 && reg <= 7 ? BIT(reg - 4) : BIT(reg);
+}
+
+/*
+ * Return the mask of x86 registers named by an insn of a kfunc or -EINVAL if
+ * the insn cannot be copied. Only moves, ALU ops, setcc and byte zero/sign
+ * extension can be: no control flow, prefixes, rip-relative addressing or
+ * implicit destination.
+ */
+static int kfunc_insn_regs(struct insn *insn)
+{
+	u8 rex = insn->rex_prefix.bytes[0], modrm = insn->modrm.bytes[0], sib = insn->sib.bytes[0];
+	u8 ext = X86_MODRM_REG(modrm), idx = X86_SIB_INDEX(sib) | X86_REX_X(rex) << 2;
+	u8 rm = X86_MODRM_RM(modrm) | X86_REX_B(rex) << 3;
+	bool byte_rm = false;
+	u32 op = insn->opcode.bytes[0];
+	int regs = 0;
+
+	if (insn->prefixes.nbytes || insn->rex_prefix.nbytes > 1 || insn->opcode.nbytes > 2 ||
+	    insn_is_avx_or_xop(insn) || insn_rip_relative(insn))
+		return -EINVAL;
+	if (insn->opcode.nbytes == 2)
+		op = op << 8 | insn->opcode.bytes[1];
+
+	switch (op) {
+	case 0x01: case 0x03:			/* add */
+	case 0x09: case 0x0b:			/* or */
+	case 0x21: case 0x23:			/* and */
+	case 0x29: case 0x2b:			/* sub */
+	case 0x31: case 0x33:			/* xor */
+	case 0x39: case 0x3b:			/* cmp */
+	case 0x63:				/* movsxd */
+	case 0x69: case 0x6b: case 0x0faf:	/* imul */
+	case 0x85:				/* test */
+	case 0x89: case 0x8b:			/* mov */
+	case 0x8d:				/* lea */
+	case 0x0f40 ... 0x0f4f:			/* cmovcc */
+	case 0x0fb7: case 0x0fbf:		/* movzx, movsx */
+		regs = BIT(ext | X86_REX_R(rex) << 1);
+		break;
+	case 0x84:				/* test (byte) */
+		regs = kfunc_byte_reg_bit(ext | X86_REX_R(rex) << 1, rex);
+		byte_rm = true;
+		break;
+	case 0x0fb6: case 0x0fbe:		/* movzx, movsx (byte) */
+		regs = BIT(ext | X86_REX_R(rex) << 1);
+		byte_rm = true;
+		break;
+	case 0x0f90 ... 0x0f9f:			/* setcc */
+		byte_rm = true;
+		break;
+	case 0x81: case 0x83:			/* ALU ops with imm */
+	case 0xc1: case 0xd1: case 0xd3:	/* shifts and rotates */
+		break;
+	case 0xc7:				/* mov imm */
+		if (ext)
+			return -EINVAL;
+		break;
+	case 0xf7:				/* test, not, neg */
+		if (ext > 3)
+			return -EINVAL;
+		break;
+	case 0xb8 ... 0xbf:			/* mov imm */
+	case 0x0fc8 ... 0x0fcf:			/* bswap */
+		return BIT((op & 7) | X86_REX_B(rex) << 3);
+	default:
+		return -EINVAL;
+	}
+	if (X86_MODRM_MOD(modrm) == 3 && byte_rm)
+		return regs | kfunc_byte_reg_bit(rm, rex);
+	if (!insn->sib.nbytes)
+		return regs | BIT(rm);
+	if (idx != 4)
+		regs |= BIT(idx);
+	/* base 5 with mod 0 is a disp32 without base, as in lea 0(,%rdi,8) */
+	if (X86_MODRM_MOD(modrm) == 0 && X86_SIB_BASE(sib) == 5)
+		return regs;
+	return regs | BIT(X86_SIB_BASE(sib) | X86_REX_B(rex) << 3);
+}
+
+/* @op is 0x50 for push and 0x58 for pop of x86 register @reg */
+static void emit_push_pop(u8 **pprog, u8 op, int reg)
+{
+	u8 *prog = *pprog;
+
+	if (reg > 7)
+		EMIT1(0x41);
+	EMIT1(op | (reg & 7));
+	*pprog = prog;
+}
+
+/* 'ret' or the jump to the return thunk at @ip, in their plain encodings */
+static bool kfunc_insn_is_ret(struct insn *insn, u8 *ip)
+{
+	u8 op = insn->opcode.bytes[0];
+
+	if (insn->prefixes.nbytes || insn->rex_prefix.nbytes || insn_is_avx_or_xop(insn) ||
+	    insn->opcode.nbytes != 1)
+		return false;
+	return op == RET_INSN_OPCODE ||
+	       (op == JMP32_INSN_OPCODE &&
+		ip + insn->length + insn->immediate.value == (u8 *)x86_return_thunk);
+}
+
+/*
+ * Inline a KF_FASTCALL kfunc: copy what the compiler generated for it without
+ * ENDBR, fentry and 'ret'. bpf_fastcall lets it clobber only R0 and the
+ * arguments. Push/pop the other caller saved registers that it uses and that
+ * are @live, the ones whose bpf_fastcall spill/fill the verifier removed.
+ */
+static int emit_kfunc_inline(u8 **pprog, unsigned long addr, const struct btf_func_model *m,
+			     u32 live)
+{
+	/* a call clobbers r10 and r11, hence nothing is live there */
+	u32 scratch = x86_reg_bit(BPF_REG_AX) | x86_reg_bit(AUX_REG);
+	u32 save = x86_reg_bit(X86_REG_R9), used = 0;
+	u8 code[KFUNC_INLINE_MAX + MAX_INSN_SIZE], *p = (u8 *)addr, *prog = *pprog;
+	unsigned long size, off, len;
+	struct insn insn;
+	int i, n, regs;
+
+	if (m->nr_args > MAX_BPF_FUNC_REG_ARGS)
+		return -EINVAL;
+	for (i = 0; i < m->nr_args; i++)
+		if (m->arg_size[i] > 8 || (m->arg_flags[i] & BTF_FMODEL_ARENA_ARG))
+			return -EINVAL;
+	for (i = BPF_REG_0; i <= BPF_REG_5; i++) {
+		if (i ? i <= m->nr_args || !(live & BIT(i)) : m->ret_size)
+			scratch |= x86_reg_bit(i);
+		else
+			save |= x86_reg_bit(i);
+	}
+
+	if (!kallsyms_lookup_size_offset(addr, &size, &off) || off)
+		return -EINVAL;
+	if (is_endbr((u32 *)p))
+		p += ENDBR_INSN_SIZE;
+	if (ftrace_location(addr) == (unsigned long)p)
+		p += MCOUNT_INSN_SIZE;
+
+	/* decode the bytes that are copied, a kprobe may change the text */
+	len = min_t(unsigned long, (u8 *)addr + size - p, sizeof(code));
+	if (copy_from_kernel_nofault(code, p, len))
+		return -EINVAL;
+	for (n = 0;; n += insn.length) {
+		if (n > KFUNC_INLINE_MAX || insn_decode(&insn, code + n, len - n, INSN_MODE_KERN))
+			return -EINVAL;
+		if (kfunc_insn_is_ret(&insn, p + n))
+			break;
+		/* the fixup of an exception table entry would not cover the copy */
+		if (search_exception_tables((unsigned long)p + n))
+			return -EINVAL;
+		regs = kfunc_insn_regs(&insn);
+		if (regs < 0)
+			return regs;
+		used |= regs;
+	}
+	if (used & ~(scratch | save))
+		return -EINVAL;
+	save &= used;
+
+	for (i = 0; i < 16; i++)
+		if (save & BIT(i))
+			emit_push_pop(&prog, 0x50, i);
+	memcpy(prog, code, n);
+	prog += n;
+	for (i = 15; i >= 0; i--)
+		if (save & BIT(i))
+			emit_push_pop(&prog, 0x58, i);
+
+	*pprog = prog;
+	return 0;
+}
+
+bool bpf_jit_inlines_kfunc_call(unsigned long addr, const struct btf_func_model *m)
+{
+	u8 buf[BPF_MAX_INSN_SIZE], *prog = buf;
+
+	return !emit_kfunc_inline(&prog, addr, m, GENMASK(BPF_REG_5, BPF_REG_1));
+}
+
 static int do_jit(struct bpf_verifier_env *env, struct bpf_prog *bpf_prog, int *addrs, u8 *image,
 		  u8 *rw_image, int oldproglen, struct jit_context *ctx, bool jmp_padding)
 {
@@ -3499,6 +3697,15 @@ static int do_jit(struct bpf_verifier_env *env, struct bpf_prog *bpf_prog, int *
 				fm = bpf_jit_find_kfunc_model(bpf_prog, insn);
 				if (!fm)
 					return -EINVAL;
+				if (fm->ret_flags & BTF_FMODEL_JIT_INLINE) {
+					u32 live = bpf_fastcall_spilled_regs(env, bpf_prog, i - 1);
+
+					err = emit_kfunc_inline(&prog, (unsigned long)func, fm,
+								live);
+					if (err)
+						return err;
+					break;
+				}
 				err = emit_kfunc_arena_args(bpf_prog, fm, &prog);
 				if (err < 0)
 					return err;
-- 
2.51.1

