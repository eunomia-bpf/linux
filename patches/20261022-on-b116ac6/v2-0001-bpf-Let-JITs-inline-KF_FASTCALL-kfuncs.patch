diff --git a/include/linux/bpf.h b/include/linux/bpf.h
index 580f89c450b5..f2c0423740fd 100644
--- a/include/linux/bpf.h
+++ b/include/linux/bpf.h
@@ -1257,6 +1257,9 @@ struct bpf_prog_offload {
 /* The argument is nullable. */
 #define BTF_FMODEL_NULLABLE_ARG		BIT(3)
 
+/* In ret_flags: the JIT inlines calls of this kfunc. */
+#define BTF_FMODEL_JIT_INLINE		BIT(4)
+
 struct btf_func_model {
 	u8 ret_size;
 	u8 ret_flags;
@@ -1696,6 +1699,8 @@ void bpf_jit_uncharge_modmem(u32 size);
 bool bpf_prog_has_trampoline(const struct bpf_prog *prog);
 bool bpf_insn_is_indirect_target(const struct bpf_verifier_env *env, const struct bpf_prog *prog,
 				 int insn_idx);
+u32 bpf_fastcall_spilled_regs(const struct bpf_verifier_env *env, const struct bpf_prog *prog,
+			      int insn_idx);
 u16 bpf_out_stack_arg_cnt(const struct bpf_verifier_env *env, const struct bpf_prog *prog);
 #else
 static inline int bpf_trampoline_link_prog(struct bpf_tramp_node *node,
diff --git a/include/linux/bpf_verifier.h b/include/linux/bpf_verifier.h
index 5926f13ff43c..9de6c182be61 100644
--- a/include/linux/bpf_verifier.h
+++ b/include/linux/bpf_verifier.h
@@ -794,6 +794,10 @@ struct bpf_insn_aux_data {
 	 * bpf_fastcall pattern.
 	 */
 	u64 fastcall_spills_num:3;
+	/* for CALL instructions, the registers whose spill/fill pairs in the
+	 * bpf_fastcall pattern are removed and must survive the call.
+	 */
+	u64 fastcall_spilled_regs:6;
 	u64 arg_prog:4;
 	/*
 	 * What a load found, on any path: an __arena pointer member of a
diff --git a/include/linux/filter.h b/include/linux/filter.h
index e0218e677a1d..04afa3b7c794 100644
--- a/include/linux/filter.h
+++ b/include/linux/filter.h
@@ -1275,6 +1275,7 @@ struct bpf_prog *bpf_int_jit_compile(struct bpf_verifier_env *env, struct bpf_pr
 void bpf_jit_compile(struct bpf_prog *prog);
 bool bpf_jit_needs_zext(void);
 bool bpf_jit_inlines_helper_call(s32 imm);
+bool bpf_jit_inlines_kfunc_call(unsigned long addr, const struct btf_func_model *m);
 bool bpf_jit_supports_subprog_tailcalls(void);
 bool bpf_jit_supports_percpu_insn(void);
 bool bpf_jit_supports_kfunc_call(void);
diff --git a/kernel/bpf/core.c b/kernel/bpf/core.c
index 3030beb531d9..a94d24c79aae 100644
--- a/kernel/bpf/core.c
+++ b/kernel/bpf/core.c
@@ -1659,6 +1659,20 @@ bool bpf_insn_is_indirect_target(const struct bpf_verifier_env *env, const struc
 	return env->insn_aux_data[insn_idx].indirect_target;
 }
 
+/*
+ * The caller saved registers that must survive a bpf_fastcall call that the
+ * JIT inlines: the ones whose spill/fill the verifier removed, or all of R1-R5
+ * without the verifier.
+ */
+u32 bpf_fastcall_spilled_regs(const struct bpf_verifier_env *env, const struct bpf_prog *prog,
+			      int insn_idx)
+{
+	if (!env)
+		return GENMASK(BPF_REG_5, BPF_REG_1);
+	insn_idx += prog->aux->subprog_start;
+	return env->insn_aux_data[insn_idx].fastcall_spilled_regs;
+}
+
 u16 bpf_out_stack_arg_cnt(const struct bpf_verifier_env *env, const struct bpf_prog *prog)
 {
 	const struct bpf_subprog_info *sub;
@@ -3372,6 +3386,15 @@ bool __weak bpf_jit_inlines_helper_call(s32 imm)
 	return false;
 }
 
+/* Return TRUE if the JIT backend inlines the KF_FASTCALL kfunc at @addr
+ * without clobbering registers that bpf_fastcall contract doesn't allow.
+ * Otherwise the kfunc is called and spills/fills around the call stay.
+ */
+bool __weak bpf_jit_inlines_kfunc_call(unsigned long addr, const struct btf_func_model *m)
+{
+	return false;
+}
+
 /* Return TRUE if the JIT backend supports mixing bpf2bpf and tailcalls. */
 bool __weak bpf_jit_supports_subprog_tailcalls(void)
 {
diff --git a/kernel/bpf/verifier.c b/kernel/bpf/verifier.c
index 5601d2056218..2c11a7663f55 100644
--- a/kernel/bpf/verifier.c
+++ b/kernel/bpf/verifier.c
@@ -3171,6 +3171,8 @@ int bpf_add_kfunc_call(struct bpf_verifier_env *env, u32 func_id, u16 offset)
 	meta.func_proto = kfunc.proto;
 	meta.func_name = kfunc.name;
 	meta.kfunc_flags = kfunc.flags ? *kfunc.flags : 0;
+	if ((meta.kfunc_flags & KF_FASTCALL) && bpf_jit_inlines_kfunc_call(addr, &func_model))
+		func_model.ret_flags |= BTF_FMODEL_JIT_INLINE;
 
 	tab = krealloc(tab, struct_size(tab, descs, tab->nr_descs + 1), GFP_KERNEL_ACCOUNT);
 	if (!tab)
@@ -19605,6 +19607,13 @@ bool bpf_verifier_inlines_helper_call(struct bpf_verifier_env *env, s32 imm)
 	}
 }
 
+/* True if bpf_fixup_kfunc_call() replaces calls to the kfunc */
+static bool verifier_inlines_kfunc_call(u32 func_id)
+{
+	return func_id == special_kfunc_list[KF_bpf_cast_to_kern_ctx] ||
+	       func_id == special_kfunc_list[KF_bpf_rdonly_cast];
+}
+
 /* If @call is a kfunc or helper call, fills @cs and returns true,
  * otherwise returns false.
  */
@@ -19633,14 +19642,18 @@ bool bpf_get_call_summary(struct bpf_verifier_env *env, struct bpf_insn *call,
 	}
 
 	if (bpf_pseudo_kfunc_call(call)) {
+		struct bpf_kfunc_desc *desc;
 		int err;
 
 		err = bpf_fetch_kfunc_arg_meta(env, call->imm, call->off, &meta);
 		if (err < 0)
 			/* error would be reported later */
 			return false;
+		desc = find_kfunc_desc(env->prog, call->imm, call->off);
 		cs->arg_slot_cnt = btf_proto_slots(meta.btf, meta.func_proto);
-		cs->fastcall = meta.kfunc_flags & KF_FASTCALL;
+		cs->fastcall = (meta.kfunc_flags & KF_FASTCALL) &&
+			       (verifier_inlines_kfunc_call(meta.func_id) ||
+				(desc && (desc->func_model.ret_flags & BTF_FMODEL_JIT_INLINE)));
 		cs->is_void = btf_type_is_void(btf_type_by_id(meta.btf, meta.func_proto->type));
 		return true;
 	}
@@ -19735,6 +19748,7 @@ static void mark_fastcall_pattern_for_call(struct bpf_verifier_env *env,
 	u32 clobbered_regs_mask;
 	struct bpf_call_summary cs;
 	u32 expected_regs_mask;
+	u32 spilled_regs = 0;
 	s16 off;
 	int i;
 
@@ -19788,6 +19802,7 @@ static void mark_fastcall_pattern_for_call(struct bpf_verifier_env *env,
 		if (stx->off != off || ldx->off != off)
 			break;
 		expected_regs_mask &= ~BIT(stx->src_reg);
+		spilled_regs |= BIT(stx->src_reg);
 		env->insn_aux_data[insn_idx - i].fastcall_pattern = 1;
 		env->insn_aux_data[insn_idx + i].fastcall_pattern = 1;
 	}
@@ -19810,10 +19825,12 @@ static void mark_fastcall_pattern_for_call(struct bpf_verifier_env *env,
 	 * don't set 'fastcall_spills_num' for call B so that remove_fastcall_spills_fills()
 	 * does not remove spill/fill pair {4,6}.
 	 */
-	if (cs.fastcall)
+	if (cs.fastcall) {
 		env->insn_aux_data[insn_idx].fastcall_spills_num = i - 1;
-	else
+		env->insn_aux_data[insn_idx].fastcall_spilled_regs = spilled_regs;
+	} else {
 		subprog->keep_fastcall_stack = 1;
+	}
 	subprog->fastcall_stack_off = min(subprog->fastcall_stack_off, off);
 }
 
@@ -23458,8 +23475,7 @@ int bpf_fixup_kfunc_call(struct bpf_verifier_env *env, struct bpf_insn *insn,
 
 		__fixup_collection_insert_kfunc(&env->insn_aux_data[insn_idx], struct_meta_reg,
 						node_offset_reg, insn, insn_buf, cnt);
-	} else if (desc->func_id == special_kfunc_list[KF_bpf_cast_to_kern_ctx] ||
-		   desc->func_id == special_kfunc_list[KF_bpf_rdonly_cast]) {
+	} else if (verifier_inlines_kfunc_call(desc->func_id)) {
 		insn_buf[0] = BPF_MOV64_REG(BPF_REG_0, BPF_REG_1);
 		*cnt = 1;
 	} else if (desc->func_id == special_kfunc_list[KF_bpf_session_is_return] &&
